{
  "name": "@company-mesh/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "company-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=../../build/company-mcp.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/rpc.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
