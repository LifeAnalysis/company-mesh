{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://company.mesh/schemas/task.schema.json",
  "title": "Company Mesh task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "title", "project", "depends_on", "parallel_safe"],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "project": { "type": "string", "minLength": 1, "maxLength": 128 },
    "depends_on": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "parallel_safe": { "type": "boolean" }
  }
}

